{
  "name": "padmaniacs",
  "version": "1.2.1",
  "description": "Pocket Pixel Art StepMania clone",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "interface": "node index.js",
    "build": "node build.js --none",
    "build:dev": "node build.js --none debug",
    "build:web": "node build.js --web",
    "build:cordova": "node build.js --cordova",
    "build:nwjs": "node build.js --nwjs",
    "build:min": "node build.js --all --minify",
    "build:dev": "node build.js --none",
    "build:release": "node build.js --all --minify --zipalign",
    "build:headless": "node build.js --all --minify --headless",
    "build:termux": "node build.js --cordova && termux-open ./dist/*.apk",
    "build:docs": "node docs-generator.js",
    "serve": "node index.js --serve",
    "serve:dist": "node index.js --serve",
    "serve:src": "node index.js --serve-src",
    "serve:dev": "node index.js --serve-src",
    "dev": "npm run build:dev && npm run serve:dist",
    "dev:fast": "npm run serve:src",
    "release": "node index.js --all --minify --zipalign",
    "release:headless": "node index.js --all --minify --zipalign --headless",
    "clean": "rm -rf dist",
    "clean:all": "rm -rf dist && rm -f *.zip *.apk && rm -rf docs",
    "test": "echo 'No tests specified'",
    "docs": "node docs-generator.js",
    "help": "node index.js --help"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RetoraDev/PadManiacs.git"
  },
  "author": "RetoraDev",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "bugs": {
    "url": "https://github.com/RetoraDev/PadManiacs/issues"
  },
  "homepage": "https://github.com/RetoraDev/PadManiacs#readme",
  "keywords": [
    "rhythm-game",
    "music-game",
    "dance",
    "stepmania",
    "ddr",
    "phaser",
    "pixel-art"
  ]
}
