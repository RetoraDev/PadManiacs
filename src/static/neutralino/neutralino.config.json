{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.retora.padmaniacs",
  "version": "%",
  "author": "Retora, https://retora.itch.io",
  "description": "Pocket Pixel Art StepMania Clone",
  "copyright": "© Retora 2026",
  "defaultMode": "window",
  "port": 5050,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "none",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "server.*",
    "debug.log"
  ],
  "modes": {
    "window": {
      "title": "PadManiacs",
      "width": 720,
      "height": 420,
      "minWidth": 240,
      "minHeight": 140,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icons/appIcon.png",
      "enableInspector": %,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true,
      "useLogicalPixels": true,
      "injectClientLibrary": true
    }
  },
  "cli": {
    "binaryName": "padmaniacs",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0"
  }
}
