#!/bin/sh
cd "$(git rev-parse --show-toplevel)" || exit 0

# Protect configured NW.js desktop target dirs from accidental deletion in commits/checkouts.
# Default includes nw; nw_ia32 is included if present.
NW_DIRS="src/static/nw src/static/nw_ia32"
BACKUP=".nw-backup"

for NW_DIR in $NW_DIRS; do
  [ -d "$NW_DIR" ] || continue
  mkdir -p "$BACKUP"

  # Sync every file currently on disk into the backup (add or update only)
  find "$NW_DIR" -type f 2>/dev/null | while IFS= read -r f; do
      rel="${f#src/static/}"
      tgt="$BACKUP/$rel"
      if [ ! -f "$tgt" ] || [ "$f" -nt "$tgt" ]; then
          mkdir -p "$(dirname "$tgt")"
          cp -p "$f" "$tgt" 2>/dev/null
      fi
  done
done

exit 0
